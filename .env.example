# Token do bot (obrigatório)
DISCORD_TOKEN=seu_token_aqui

# Opcional
PORT=3000

# ===== WHITELIST DE SERVIDORES/USUÁRIOS =====
# IDs dos servidores autorizados (vazio = todos)
GUILD_WHITELIST=

# IDs dos admins que podem usar !painel
USER_WHITELIST=

# ===== PAINEL DE LIBERAÇÃO =====
# Canal onde as solicitações vão aparecer (ID do canal)
LOG_CHANNEL_ID=

# URL direta da imagem PNG (328x328) que aparece no canto direito do painel
# Exemplo: https://i.imgur.com/xxxxx.png
PANEL_IMAGE_URL=

# Cargo dado automaticamente quando a pessoa solicita (opcional)
# Deixe vazio se a liberação for manual
AUTO_ROLE_ID=
