# Token do bot (obrigatório)
DISCORD_TOKEN=seu_token_aqui

# Opcional
CLIENT_ID=id_do_seu_aplicativo
PORT=3000

# ===== WHITELIST =====
# IDs dos servidores autorizados (separados por vírgula)
# Deixe vazio = funciona em TODOS os servidores
# Exemplo: GUILD_WHITELIST=123456789012345678,987654321098765432
GUILD_WHITELIST=

# IDs dos usuários que podem usar comandos de admin (separados por vírgula)
# Deixe vazio = qualquer um pode usar os comandos públicos
# Exemplo: USER_WHITELIST=111111111111111111,222222222222222222
USER_WHITELIST=
